# MCP Workbench environment template.
# Copy this file to `.env` and replace placeholders with your own values.

# App runtime
MCP_WORKBENCH_APP_NAME=MCP Workbench
MCP_WORKBENCH_ENVIRONMENT=development
MCP_WORKBENCH_DEBUG=false
MCP_WORKBENCH_HOST=127.0.0.1
MCP_WORKBENCH_PORT=8000
MCP_WORKBENCH_LOG_LEVEL=INFO
MCP_WORKBENCH_DATABASE_URL=sqlite:///./data/mcp_workbench.db

# Chat provider
# The app uses an OpenAI-compatible `/chat/completions` API:
#   {LLM_BASE_URL}/chat/completions
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_MODELS='["gpt-4.1-mini", "gpt-4.1", "o4-mini"]'
LLM_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=5
LLM_USE_SYSTEM_PROMPT=true

# Prompt profiles
MCP_WORKBENCH_PROMPT_PROFILES_PATH=app/prompts/profiles.yaml
MCP_WORKBENCH_DEFAULT_PROMPT_PROFILE=default

# MCP
# Optional path to a YAML file containing MCP server definitions.
# If unset, the app reads mcp-servers.yaml from the project root when it exists.
MCP_WORKBENCH_MCP_SERVERS_PATH=mcp-servers.yaml

# Set to one of the configured MCP server names to enable it by default.
# Leave empty or unset to start with no MCP server selected.
MCP_WORKBENCH_DEFAULT_MCP_SERVER=

# Alternative provider examples
#
# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_MODELS='["gpt-4.1-mini", "gpt-4.1", "o4-mini"]'
#
# Vertex AI
# LLM_PROVIDER=vertex_ai
# VERTEX_AI_PROJECT=your-gcp-project-id
# Use global or a full Vertex AI region id, for example europe-west1.
# VERTEX_AI_LOCATION=global
# VERTEX_AI_CREDENTIALS_PATH=/secure/path/service-account.json
# LLM_MODEL=google/gemini-2.5-flash
# LLM_MODELS='["google/gemini-2.5-flash", "google/gemini-2.5-pro"]'
#
# LiteLLM
# LLM_PROVIDER=litellm
# LLM_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_MODELS='["openai/gpt-4.1-mini", "anthropic/claude-sonnet-4-5-20250929"]'
#
# Vertex AI through LiteLLM
# LLM_PROVIDER=litellm
# VERTEX_AI_PROJECT=your-gcp-project-id
# VERTEX_AI_LOCATION=global
# VERTEX_AI_CREDENTIALS_PATH=/secure/path/service-account.json
# LLM_MODEL=vertex_ai/gemini-2.5-flash
# LLM_MODELS='["vertex_ai/gemini-2.5-flash", "vertex_ai/gemini-2.5-pro"]'
#
# Ollama
# LLM_PROVIDER=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_MODELS='["llama3.1", "qwen2.5-coder"]'
#
# LM Studio
# LLM_PROVIDER=openai
# LLM_API_KEY=lm-studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# LLM_MODELS='["local-model"]'
#
# LocalAI
# LLM_PROVIDER=openai
# LLM_API_KEY=localai
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=local-model
# LLM_MODELS='["local-model"]'
